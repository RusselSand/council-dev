# Образец настроек: скопируйте в frontend/.env и поменяйте. Сам .env в git не попадает.

# Откуда брать данные: http — настоящий сервер (по умолчанию), mock — моки из макета. Моки без этой строки —
# npm run dev:mock; сборке для сервера её не задавайте: собранный фронт ходит в сервер.
# VITE_DATA_SOURCE=http

# Адрес API для http; по умолчанию /api на том же сервере.
# VITE_API_URL=/api

# Куда npm run dev передаёт запросы /api: бекенд; по умолчанию http://localhost:8420.
# VITE_API_PROXY=http://localhost:8420

# 1 — vite опрашивает файлы, а не ждёт событий файловой системы: так в докере на Windows.
# VITE_USE_POLLING=1
